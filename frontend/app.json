{
  "expo": {
    "name": "Image to PDF",
    "slug": "image-to-pdf",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imagetopdf",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pauldigital.imagetopdf",
      "infoPlist": {
        "NSCameraUsageDescription": "Take photos to add to your PDF",
        "NSPhotoLibraryUsageDescription": "Select photos to convert to PDF"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4A7B59"
      },
      "package": "com.pauldigital.imagetopdf",
      "versionCode": 1,
      "permissions": ["android.permission.CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F2F7"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "expo-sharing",
      "@react-native-vector-icons/ionicons",
      [
        "expo-image-picker",
        {
          "photosPermission": "Select photos to convert to PDF",
          "cameraPermission": "Take photos to add to your PDF"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5048291410050597~8128736566",
          "iosAppId": "ca-app-pub-5048291410050597~8128736566"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
